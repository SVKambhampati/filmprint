{
  "name": "filmprint",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "See your filmprint \u2014 stats about what your Letterboxd history says about you.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build:dataset": "node --env-file=.env src/generator/build.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check:matcher": "node --env-file=.env src/tmdb/check-matcher.ts",
    "page": "node src/generator/page.ts",
    "stats": "node src/generator/stats.ts",
    "dump:payload": "node src/generator/payload.ts",
    "dev": "vite",
    "build:web": "vite build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.8.0",
    "vite": "^7.3.6"
  }
}
